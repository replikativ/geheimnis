{:source-paths ["src" "test"]

 ;; deps resolved from deps.edn so the :local overlay (-A:local) can override
 ;; hasch to the sibling checkout during co-development.
 :deps {:aliases [:cljs :test]}

 :builds
 {:ci
  {:target :karma
   :output-to "target/ci.js"
   :ns-regexp "-test$"
   :compiler-options {:warnings {:fn-deprecated false}}}

  :test
  {:target :karma
   :output-to "target/test.js"
   :ns-regexp "-test$"
   :compiler-options {:warnings {:fn-deprecated false}}}

  :browser-test
  {:target :browser-test
   :test-dir "target/browser-test"
   :ns-regexp "-test$"
   :compiler-options {:warnings {:fn-deprecated false}}}

  :node-test
  {:target :node-test
   :output-to "target/node-test.js"
   ;; v2 crypto tests only (the legacy geheimnis.* jsbn tests don't run on node)
   :ns-regexp "^org\\.replikativ\\.geheimnis\\..*-test$"
   :compiler-options {:warnings {:fn-deprecated false}}}}}
